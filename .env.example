# Supabase
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# MercadoPago (opcional — habilita pagos online en el menú QR)
MERCADOPAGO_ACCESS_TOKEN=your-access-token
MERCADOPAGO_WEBHOOK_SECRET=your-webhook-secret

# App
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Datos del restaurante (aparecen en el ticket/factura)
NEXT_PUBLIC_RESTAURANT_NAME=Mi Restaurante
NEXT_PUBLIC_RESTAURANT_ADDRESS=Av. Principal 123, Col. Centro
NEXT_PUBLIC_RESTAURANT_PHONE=+52 555 123 4567
NEXT_PUBLIC_RESTAURANT_RFC=
NEXT_PUBLIC_RESTAURANT_WEBSITE=

# IVA en el ticket (true = desglosar subtotal + IVA, false = solo total)
NEXT_PUBLIC_SHOW_TAX=false
NEXT_PUBLIC_TAX_RATE=16

# Activar botón "Pagar con MercadoPago" en el menú QR (true/false)
NEXT_PUBLIC_ENABLE_PAYMENTS=false
